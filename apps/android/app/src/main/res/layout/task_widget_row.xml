<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="110dp" android:orientation="vertical" android:paddingBottom="6dp">
    <TextView android:id="@+id/widget_item_title" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="#E5EBDF" />
    <TextView android:id="@+id/widget_item_detail" android:layout_width="match_parent" android:layout_height="18dp" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="#B8C4AD" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <TextView android:id="@+id/widget_done" android:layout_width="68dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Done…" android:contentDescription="Open completion form" android:textSize="12sp" android:textColor="@color/household_accent" />
        <TextView android:id="@+id/widget_move" android:layout_width="88dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Move date…" android:contentDescription="Open date controls" android:textSize="12sp" android:textColor="@color/household_accent" />
    </LinearLayout>
</LinearLayout>
