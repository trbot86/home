{
  "name": "our-place",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "test:browser": "playwright test",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:suggestion-bridge": "node --import tsx --test scripts/suggestion-bridge/bridge.test.mjs",
    "check:public-source": "node scripts/check-public-source.mjs",
    "android:assets": "pnpm --filter @our-place/web build && cap sync android",
    "dev": "pnpm --parallel --filter @our-place/server --filter @our-place/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test:boundaries && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2"
  }
}
